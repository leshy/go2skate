.DS_Store

# Generated by the scripts. Tracked anyway, so the defaults can be printed or simulated without running anything:
# print/ (what to print), models/ (STEP/STL exports), sim/generated/meshes/ (what the MJCF loads). Rerun the scripts after changing
# config.py and commit what changes.
*.stl
*.step
!print/*.stl
!models/*.step
!models/*.stl
!sim/generated/meshes/*.stl
!go2skate/data/*.stl
builds/
